<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Model Metrics"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:textAlignment="center"
        android:layout_marginBottom="16dp" />
        
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="400dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.1 Training Performance"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />
                
            <TextView
                android:id="@+id/metrics_training"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="14sp"
                android:textColor="#555555"
                android:lineSpacingExtra="4dp"/>
                
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="12dp"/>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.2 Classification Evaluation"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />
                
            <TextView
                android:id="@+id/metrics_classification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="14sp"
                android:textColor="#555555"
                android:lineSpacingExtra="4dp"/>
                
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="12dp"/>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.3 Inference Performance (Averages)"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />
                
            <TextView
                android:id="@+id/metrics_inference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="14sp"
                android:textColor="#555555"
                android:lineSpacingExtra="4dp"/>
                
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_close_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close"
        android:layout_marginTop="16dp"
        android:backgroundTint="#81C784" />

</LinearLayout>
