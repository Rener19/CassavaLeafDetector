<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thesis Evaluation Metrics"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:textAlignment="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5-Seed Overall Performance (Mean ± Std)"
        android:textSize="12sp"
        android:textColor="#666666"
        android:textAlignment="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />
        
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="440dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.1 Training Time &amp; Resource Usage"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:textSize="15sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />
                
            <TextView
                android:id="@+id/metrics_training"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="13sp"
                android:textColor="#424242"
                android:lineSpacingExtra="3dp"/>
                
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="10dp"/>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.2 Classification Evaluation (Test Set)"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />
                
            <TextView
                android:id="@+id/metrics_classification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="13sp"
                android:textColor="#424242"
                android:lineSpacingExtra="3dp"/>
                
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="10dp"/>
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.3 Inference Performance Metrics"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />
                
            <TextView
                android:id="@+id/metrics_inference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="13sp"
                android:textColor="#424242"
                android:lineSpacingExtra="3dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.4 Mobile App Evaluation (5-Seed Average)"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/metrics_mobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="13sp"
                android:textColor="#424242"
                android:lineSpacingExtra="3dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2.5 Welch's t-Test on MCC Significance"
                android:textStyle="bold"
                android:textColor="#388E3C"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/metrics_statistical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="13sp"
                android:textColor="#424242"
                android:lineSpacingExtra="3dp"/>
                
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_close_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close"
        android:layout_marginTop="16dp"
        android:backgroundTint="#81C784" />

</LinearLayout>
