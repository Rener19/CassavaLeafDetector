<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Batch Test Models"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Upload multiple images into each ground truth class."
                android:textColor="@color/gray_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_clear_all_batch_inputs"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear All"
                android:textColor="@color/gray_text" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/color_cbb"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                
                <View android:layout_width="16dp" android:layout_height="16dp" android:background="@color/color_cbb" android:layout_marginEnd="12dp" />
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blight (CBB)"
                        android:textStyle="bold"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/txt_count_cbb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 images selected"
                        android:textSize="12sp" />
                </LinearLayout>
                
                <Button
                    android:id="@+id/btn_clear_cbb"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textColor="@color/gray_text"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_upload_cbb"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload"
                    app:strokeColor="@color/color_cbb"
                    android:textColor="@color/color_cbb" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/color_cbsd"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                
                <View android:layout_width="16dp" android:layout_height="16dp" android:background="@color/color_cbsd" android:layout_marginEnd="12dp" />
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Streak (CBSD)"
                        android:textStyle="bold"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/txt_count_cbsd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 images selected"
                        android:textSize="12sp" />
                </LinearLayout>
                
                <Button
                    android:id="@+id/btn_clear_cbsd"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textColor="@color/gray_text"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_upload_cbsd"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload"
                    app:strokeColor="@color/color_cbsd"
                    android:textColor="@color/color_cbsd" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/color_cgm"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                
                <View android:layout_width="16dp" android:layout_height="16dp" android:background="@color/color_cgm" android:layout_marginEnd="12dp" />
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mottle (CGM)"
                        android:textStyle="bold"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/txt_count_cgm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 images selected"
                        android:textSize="12sp" />
                </LinearLayout>
                
                <Button
                    android:id="@+id/btn_clear_cgm"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textColor="@color/gray_text"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_upload_cgm"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload"
                    app:strokeColor="@color/color_cgm"
                    android:textColor="@color/color_cgm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/color_cmd"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                
                <View android:layout_width="16dp" android:layout_height="16dp" android:background="@color/color_cmd" android:layout_marginEnd="12dp" />
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mosaic (CMD)"
                        android:textStyle="bold"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/txt_count_cmd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 images selected"
                        android:textSize="12sp" />
                </LinearLayout>
                
                <Button
                    android:id="@+id/btn_clear_cmd"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textColor="@color/gray_text"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_upload_cmd"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload"
                    app:strokeColor="@color/color_cmd"
                    android:textColor="@color/color_cmd" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/color_healthy"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">
                
                <View android:layout_width="16dp" android:layout_height="16dp" android:background="@color/color_healthy" android:layout_marginEnd="12dp" />
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Healthy"
                        android:textStyle="bold"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/txt_count_healthy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 images selected"
                        android:textSize="12sp" />
                </LinearLayout>
                
                <Button
                    android:id="@+id/btn_clear_healthy"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textColor="@color/gray_text"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_upload_healthy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload"
                    app:strokeColor="@color/color_healthy"
                    android:textColor="@color/color_healthy" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Confidence Threshold Setting Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Confidence Threshold"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                        
                    <TextView
                        android:id="@+id/txt_batch_threshold_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60%"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Predictions below this confidence level are excluded from evaluation."
                    android:textColor="@color/gray_text"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp" />

                <SeekBar
                    android:id="@+id/seek_batch_threshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="60"
                    android:progressTint="@color/primary_green"
                    android:thumbTint="@color/primary_green" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0% (All Images)"
                        android:textColor="@color/gray_text"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100% (Strict)"
                        android:textColor="@color/gray_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Evaluation Mode Setting Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Evaluation Mode"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_batch_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@id/btn_mode_paired">

                    <Button
                        android:id="@+id/btn_mode_paired"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mode 1 (Paired)"
                        android:textSize="12sp"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_mode_independent"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mode 2 (Independent)"
                        android:textSize="12sp"
                        android:textAllCaps="false" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/txt_batch_mode_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mode 1 (Paired): Both models evaluated on the same image subset accepted by the Enhanced model."
                    android:textColor="@color/gray_text"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btn_run_batch_test"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Run Test"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            app:cornerRadius="12dp" />
            
        <ProgressBar
            android:id="@+id/progress_batch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:id="@+id/layout_batch_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test Results"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />
                
            <TextView
                android:id="@+id/txt_batch_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:background="@color/light_green_bg"
                android:padding="16dp"
                android:lineSpacingExtra="4dp"
                android:typeface="monospace"
                android:textSize="12sp"
                android:layout_marginBottom="24dp" />
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Batch Test History"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_clear_batch_history"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear All"
                android:textColor="@color/gray_text" />
        </LinearLayout>
            
        <TextView
            android:id="@+id/txt_no_batch_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="24dp"
            android:visibility="gone"
            android:text="No past batch tests found."
            android:textAlignment="center"
            android:textColor="@color/gray_text"
            android:textSize="14sp" />
            
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_batch_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
