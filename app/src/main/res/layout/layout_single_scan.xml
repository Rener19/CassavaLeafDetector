<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nestedScrollView"
    android:paddingBottom="40.000000dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16.000000dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18.000000sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12.000000dp"
            android:text="Start Diagnosis" />
        <Button
            android:id="@+id/btn_view_thesis_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16.000000dp"
            android:text="Model Metrics"
            android:backgroundTint="@color/accent_green"
            app:cornerRadius="8.000000dp" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24.000000dp"
            android:baselineAligned="false"
            android:weightSum="2">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_camera"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0.000000dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8.000000dp"
                app:cardCornerRadius="16.000000dp"
                app:cardElevation="2.000000dp"
                app:rippleColor="@color/light_green_bg"
                app:strokeColor="@color/primary_green"
                app:strokeWidth="1.000000dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20.000000dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="48.000000dp"
                        android:layout_height="48.000000dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="@color/primary_green" />
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.000000dp"
                        android:text="Take Photo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gallery"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0.000000dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8.000000dp"
                app:cardCornerRadius="16.000000dp"
                app:cardElevation="2.000000dp"
                app:rippleColor="@color/light_green_bg"
                app:strokeColor="@color/primary_green"
                app:strokeWidth="1.000000dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20.000000dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="48.000000dp"
                        android:layout_height="48.000000dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        app:tint="@color/primary_green" />
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12.000000dp"
                        android:text="Upload Image" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/camera_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24.000000dp"
            app:cardCornerRadius="16.000000dp"
            app:cardElevation="4.000000dp"
            app:strokeWidth="0.000000dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="400.000000dp">
                <androidx.camera.view.PreviewView
                    android:id="@+id/preview_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <View
                    android:background="#66000000"
                    android:layout_width="match_parent"
                    android:layout_height="80.000000dp"
                    app:layout_constraintBottom_toBottomOf="parent" />
                <ImageButton
                    android:id="@+id/btn_capture"
                    android:background="@android:color/transparent"
                    android:layout_width="64.000000dp"
                    android:layout_height="64.000000dp"
                    android:layout_marginBottom="16.000000dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="@color/white" />
                <ImageButton
                    android:id="@+id/btn_close_camera"
                    android:background="@android:color/transparent"
                    android:layout_width="48.000000dp"
                    android:layout_height="48.000000dp"
                    android:layout_margin="16.000000dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_result"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24.000000dp"
            app:cardCornerRadius="16.000000dp"
            app:cardElevation="4.000000dp"
            app:strokeWidth="0.000000dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@color/light_green_bg"
                    android:padding="16.000000dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="24.000000dp"
                        android:layout_height="24.000000dp"
                        android:src="@android:drawable/ic_menu_help"
                        app:tint="@color/primary_green" />
                    <TextView
                        android:textSize="16.000000sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green_dark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Analysis Complete"
                        android:layout_marginStart="8.000000dp" />
                    <View
                        android:layout_width="0.000000dp"
                        android:layout_height="0.000000dp"
                        android:layout_weight="1" />
                    <TextView
                        android:textSize="10.000000sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/txt_model_badge"
                        android:background="@drawable/badge_bg"
                        android:paddingLeft="8.000000dp"
                        android:paddingTop="4.000000dp"
                        android:paddingRight="8.000000dp"
                        android:paddingBottom="4.000000dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Model"
                        android:paddingHorizontal="8.000000dp"
                        android:paddingVertical="4.000000dp" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.000000dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipToPadding="false"
                        android:layout_marginBottom="16.000000dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Original Image Section -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                android:layout_marginEnd="12.000000dp">

                                <TextView
                                    android:textSize="12.000000sp"
                                    android:textColor="@color/gray_text"
                                    android:id="@+id/label_original"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="6.000000dp"
                                    android:text="Original" />

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/card_scanned"
                                    android:layout_width="190.000000dp"
                                    android:layout_height="190.000000dp"
                                    app:cardCornerRadius="12.000000dp"
                                    app:strokeColor="#ffe0e0e0"
                                    app:strokeWidth="1.000000dp">
                                    <ImageView
                                        android:id="@+id/img_scanned"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop" />
                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>

                            <!-- D-CLAHE Image Section -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center_horizontal">

                                <TextView
                                    android:textSize="12.000000sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/accent_green"
                                    android:id="@+id/label_enhanced"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="6.000000dp"
                                    android:text="D-CLAHE View" />

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/card_enhanced"
                                    android:layout_width="190.000000dp"
                                    android:layout_height="190.000000dp"
                                    app:cardCornerRadius="12.000000dp"
                                    app:strokeColor="#ffe0e0e0"
                                    app:strokeWidth="1.000000dp">
                                    <ImageView
                                        android:id="@+id/img_enhanced"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop" />
                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>

                        </LinearLayout>
                    </HorizontalScrollView>
                    <TextView
                        android:textSize="20.000000sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/txt_enhanced_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4.000000dp"
                        android:text="Cassava Mosaic Disease" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8.000000dp">
                        <TextView
                            android:textSize="14.000000sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_green"
                            android:id="@+id/txt_enhanced_confidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="96%" />
                        <ProgressBar
                            android:id="@+id/progress_enhanced_confidence"
                            android:layout_width="0.000000dp"
                            android:layout_height="8.000000dp"
                            android:progress="96"
                            android:layout_weight="1"
                            android:layout_marginStart="12.000000dp"
                            android:progressTint="@color/accent_green"
                            android:progressBackgroundTint="@color/light_green_bg"
                            style="?android:attr/progressBarStyleHorizontal" />
                    </LinearLayout>
                    <TextView
                        android:textSize="10.000000sp"
                        android:textColor="@color/gray_text"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/txt_enhanced_other_probs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CBB: 0% | CBSD: 0% | CGM: 0% | CMD: 0% | Healthy: 0%" />
                    <TextView
                        android:textSize="12.000000sp"
                        android:textColor="@color/gray_text"
                        android:id="@+id/txt_enhanced_metrics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8.000000dp"
                        android:text="Inference Time: -- ms | Size: -- KB" />
                    <View
                        android:background="#ffeeeeee"
                        android:layout_width="match_parent"
                        android:layout_height="1.000000dp"
                        android:layout_marginTop="16.000000dp"
                        android:layout_marginBottom="16.000000dp"
                        android:layout_marginVertical="16.000000dp" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="#fff9f9f9"
                        android:padding="16.000000dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14.000000sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12.000000dp"
                            android:text="Base Model Output (MobileNetV3)" />
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8.000000dp">
                            <TextView
                                android:textSize="16.000000sp"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:id="@+id/txt_base_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Waiting..."
                                android:layout_alignParentStart="true" />
                            <TextView
                                android:textSize="16.000000sp"
                                android:textStyle="bold"
                                android:textColor="@color/gray_text"
                                android:id="@+id/txt_base_confidence"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:layout_alignParentEnd="true" />
                        </RelativeLayout>
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_base_confidence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4.000000dp"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="@color/gray_text"
                            app:trackColor="#ffe0e0e0"
                            app:trackCornerRadius="4.000000dp" />
                        <TextView
                            android:textSize="10.000000sp"
                            android:textColor="@color/gray_text"
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/txt_base_other_probs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CBB: 0% | CBSD: 0% | CGM: 0% | CMD: 0% | Healthy: 0%" />
                        <TextView
                            android:textSize="12.000000sp"
                            android:textColor="@color/gray_text"
                            android:id="@+id/txt_base_metrics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8.000000dp"
                            android:text="Inference Time: -- ms | Size: -- KB" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12.000000dp">
            <TextView
                android:textSize="18.000000sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="0.000000dp"
                android:layout_height="wrap_content"
                android:text="Scan History"
                android:layout_weight="1" />
            <Button
                android:textColor="@color/gray_text"
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear All"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>
        <TextView
            android:textSize="14.000000sp"
            android:textColor="@color/gray_text"
            android:id="@+id/txt_no_history"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24.000000dp"
            android:layout_marginBottom="24.000000dp"
            android:text="No past diagnoses found. Scans will be saved here locally."
            android:textAlignment="4"
            android:layout_marginVertical="24.000000dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_history"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
