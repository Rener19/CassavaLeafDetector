<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            

            <!-- Diagnostic Control Panel -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Quick Actions"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <!-- Camera Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_camera"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/light_green_bg"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="@color/primary_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Camera Scan"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Capture leaf live"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Gallery Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_gallery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/light_green_bg"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@android:drawable/ic_menu_gallery"
                            app:tint="@color/primary_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Upload Image"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Select from gallery"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Results Section (Visible after image selection) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diagnosis Result"
                        android:textColor="@color/primary_green"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginEnd="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Original Image"
                                android:textColor="@color/gray_text"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp"/>
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                app:cardCornerRadius="8dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/img_scanned"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    tools:src="@android:drawable/ic_menu_report_image"/>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginStart="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="D-CLAHE Enhanced"
                                android:textColor="@color/accent_green"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp"/>
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                app:cardCornerRadius="8dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/img_enhanced"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    tools:src="@android:drawable/ic_menu_report_image"/>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                            <!-- Base Model Section -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Base Model (MobileNetV3)"
                                android:textColor="@color/gray_text"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/txt_base_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cassava Mosaic Disease"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical">
                                <TextView
                                    android:id="@+id/txt_base_confidence"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="92% Conf."
                                    android:textColor="@color/accent_green"
                                    android:textStyle="bold"
                                    android:textSize="12sp"/>
                                <ProgressBar
                                    android:id="@+id/progress_base_confidence"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="4dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginEnd="8dp"
                                    android:progress="92"
                                    android:progressTint="@color/accent_green"
                                    android:progressBackgroundTint="@color/light_green_bg"/>
                                <TextView
                                    android:id="@+id/txt_base_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="30ms"
                                    android:textColor="@color/gray_text"
                                    android:textSize="10sp"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txt_base_metrics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Shape: N/A | Type: N/A | Size: N/A"
                                android:textColor="@color/gray_text"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp"/>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="8dp"
                                android:background="#F0F0F0"/>

                            <!-- Enhanced Model Section -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Enhanced Model"
                                android:textColor="@color/gray_text"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/txt_enhanced_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cassava Mosaic Disease"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical">
                                <TextView
                                    android:id="@+id/txt_enhanced_confidence"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="96% Conf."
                                    android:textColor="@color/accent_green"
                                    android:textStyle="bold"
                                    android:textSize="12sp"/>
                                <ProgressBar
                                    android:id="@+id/progress_enhanced_confidence"
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="0dp"
                                    android:layout_height="4dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginEnd="8dp"
                                    android:progress="96"
                                    android:progressTint="@color/accent_green"
                                    android:progressBackgroundTint="@color/light_green_bg"/>
                                <TextView
                                    android:id="@+id/txt_enhanced_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="15ms"
                                    android:textColor="@color/gray_text"
                                    android:textSize="10sp"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txt_enhanced_metrics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Shape: N/A | Type: N/A | Size: N/A"
                                android:textColor="@color/gray_text"
                                android:textSize="10sp"
                                android:layout_marginTop="2dp"/>

                            <TextView
                                android:id="@+id/txt_model_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/badge_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="Models Loaded"
                                android:textColor="@color/white"
                                android:textSize="10sp"/>

                        </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginVertical="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disease Overview:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/txt_disease_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="CMD causes chlorosis, leaves distortion and stunting of plant growth, heavily reducing crop yields."
                        android:textColor="@color/gray_text"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Control &amp; Prevention:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/txt_disease_treatment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Plant resistant cultivars, select healthy stem cuttings, and destroy infected plants immediately."
                        android:textColor="@color/gray_text"
                        android:textSize="13sp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            

            <!-- Camera Preview View (Overlayed/Used when Scanning) -->
            <FrameLayout
                android:id="@+id/camera_container"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <androidx.camera.view.PreviewView
                    android:id="@+id/preview_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:scaleType="fillCenter" />

                <!-- Scanning guide overlay box -->
                <View
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/camera_guide_box"/>

                <ImageButton
                    android:id="@+id/btn_capture"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/btn_capture_bg"
                    android:contentDescription="Capture Photo"
                    android:elevation="6dp" />

                <ImageButton
                    android:id="@+id/btn_close_camera"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/btn_close_bg"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="Close Camera"
                    app:tint="@color/white" />
            </FrameLayout>

            

            <!-- Diagnosis History -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Diagnosis History"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            
            <Button
                android:id="@+id/btn_view_thesis_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Model Metrics"
                android:layout_marginBottom="16dp"
                app:cornerRadius="8dp"
                android:backgroundTint="@color/accent_green" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:listitem="@layout/item_history"
                        android:nestedScrollingEnabled="false"/>

                    <TextView
                        android:id="@+id/txt_no_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="No previous scans. Scan a leaf to build history."
                        android:textColor="@color/gray_text"
                        android:textSize="13sp"/>

                    <Button
                        android:id="@+id/btn_clear_history"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="Clear History"
                        android:textColor="@color/color_cbb"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>